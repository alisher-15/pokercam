{
  "name": "media-server",
  "private": true,
  "type": "module",
  "description": "mediasoup SFU: rooms, signaling, control hub, license checks and the DVR (FFmpeg → HLS).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "esbuild web/viewer.ts --bundle --minify --format=esm --target=es2022 --outfile=dist/web/viewer.js && cp web/viewer.html dist/web/viewer.html",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mediasoup": "^3.32.0",
    "pino": "10.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "mediasoup-client": "3.25.3",
    "qrcode-generator": "2.0.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "mediasoup@3.32.0": true,
    "esbuild@0.28.2": true
  }
}
