{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InternalLicenseResponse",
  "description": "GET /api/v1/internal/tables/{id}/license (docker network only, called by media-server)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table_id",
    "client_id",
    "status",
    "paid_until",
    "grace_until"
  ],
  "properties": {
    "table_id": {
      "$ref": "../common.json#/definitions/Uuid"
    },
    "client_id": {
      "$ref": "../common.json#/definitions/Uuid"
    },
    "status": {
      "$ref": "../common.json#/definitions/LicenseStatus"
    },
    "paid_until": {
      "$ref": "../common.json#/definitions/DateTime"
    },
    "grace_until": {
      "$ref": "../common.json#/definitions/DateTime"
    },
    "camera_device_id": {
      "$ref": "../common.json#/definitions/Uuid",
      "description": "The phone paired to the table now; media-server lets only this device publish. Absent when no phone is paired."
    }
  }
}
