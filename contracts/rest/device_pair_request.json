{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevicePairRequest",
  "description": "POST /api/v1/device/pair",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "model",
    "android_id"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "android_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stored as a hash only."
    }
  }
}
