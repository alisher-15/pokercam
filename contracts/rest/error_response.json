{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse",
  "description": "Body of every 4xx/5xx response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detail"
  ],
  "properties": {
    "detail": {
      "title": "ApiError",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable machine-readable code, e.g. pairing_code_expired."
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
