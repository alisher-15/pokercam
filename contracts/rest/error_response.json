{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse",
  "description": "Body of every 4xx/5xx response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "detail"
  ],
  "properties": {
    "detail": {
      "title": "ApiError",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable machine-readable code, e.g. pairing_code_expired."
        },
        "message": {
          "type": "string"
        },
        "seller_contacts": {
          "$ref": "../common.json#/definitions/SellerContacts"
        }
      },
      "description": "code and message; on license errors (license_expired, license_suspended, no_license) also seller_contacts, how the club reaches its seller (SPEC 8.4)."
    }
  }
}
