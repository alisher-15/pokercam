{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SignalingJoinResultMessage",
  "description": "Server -> sender of signaling.join: success. Failures come as signaling.error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "ts",
    "table_id",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "signaling.join.result"
    },
    "id": {
      "$ref": "../../common.json#/definitions/MessageId"
    },
    "ts": {
      "$ref": "../../common.json#/definitions/TimestampMs"
    },
    "table_id": {
      "$ref": "../../common.json#/definitions/Uuid"
    },
    "payload": {
      "title": "SignalingJoinResultPayload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "role",
        "peer_id",
        "session_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "../../common.json#/definitions/MessageId"
        },
        "role": {
          "$ref": "../../common.json#/definitions/Role"
        },
        "peer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "mediasoup object id."
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  }
}
