{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SignalingJoinMessage",
  "description": "Client -> server: enter the table's room. Role and table come from the token, never from the message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "ts",
    "table_id",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "signaling.join"
    },
    "id": {
      "$ref": "../../common.json#/definitions/MessageId"
    },
    "ts": {
      "$ref": "../../common.json#/definitions/TimestampMs"
    },
    "table_id": {
      "$ref": "../../common.json#/definitions/Uuid"
    },
    "payload": {
      "title": "SignalingJoinPayload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "Access JWT from POST /api/v1/auth/token."
        }
      }
    }
  }
}
