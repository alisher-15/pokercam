{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SignalingConsumeMessage",
  "description": "Viewer -> server: receive the table's video. The consumer starts paused; send signaling.resume after setting it up.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "ts",
    "table_id",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "signaling.consume"
    },
    "id": {
      "$ref": "../../common.json#/definitions/MessageId"
    },
    "ts": {
      "$ref": "../../common.json#/definitions/TimestampMs"
    },
    "table_id": {
      "$ref": "../../common.json#/definitions/Uuid"
    },
    "payload": {
      "title": "SignalingConsumePayload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport_id",
        "rtp_capabilities"
      ],
      "properties": {
        "transport_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "mediasoup object id."
        },
        "rtp_capabilities": {
          "type": "object",
          "description": "mediasoup RtpCapabilities of the client's Device."
        }
      }
    }
  }
}
