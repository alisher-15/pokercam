# Copy to .env: cp .env.example .env
# docker compose, the Makefile and the backend read it. Never commit .env.

# development: missing secrets get throwaway values. production: the backend refuses to start without them.
ENVIRONMENT=development

# PostgreSQL in docker compose. Change the password anywhere but a laptop.
POSTGRES_USER=pokercam
POSTGRES_PASSWORD=pokercam
POSTGRES_DB=pokercam
POSTGRES_PORT=5432

# Published ports
BACKEND_PORT=8000
MEDIA_SERVER_PORT=3000

LOG_LEVEL=info

# Backend run on the host (uvicorn); inside docker compose it is set from POSTGRES_* above.
DATABASE_URL=postgresql+psycopg://pokercam:pokercam@localhost:5432/pokercam
# Backend tests: a separate database, created on the first run.
TEST_DATABASE_URL=postgresql+psycopg://pokercam:pokercam@localhost:5432/pokercam_test

# Admin panel shows and takes dates in this zone, e.g. Asia/Almaty.
TIMEZONE=UTC
# Address phones reach the backend at; it goes into the pairing QR code.
PUBLIC_API_URL=http://localhost:8000
# Access token lifetime, seconds (SPEC 9.1: 12 h). How long a client has access is set by its license.
ACCESS_TOKEN_TTL=43200

# Secrets: `make keys` prints all four. Changing HASH_SECRET voids every activation key.
JWT_PRIVATE_KEY=
HASH_SECRET=
INTERNAL_API_TOKEN=
ADMIN_SESSION_SECRET=

# First admin of the admin panel (/admin), created by `make seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
